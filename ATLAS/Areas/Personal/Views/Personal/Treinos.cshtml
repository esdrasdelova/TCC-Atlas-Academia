@model List<Treino>
@{
    var aviso = TempData["Aviso"] as string;
    var alunosAtivos = ViewBag.AlunosAtivos is int n ? n : 0;
}

<div class="saudacao">
    <h2>Gerenciar <em>treinos</em></h2>
    <p>Crie, atualize e acompanhe as fichas de treino dos seus alunos.</p>
</div>

@if (!string.IsNullOrEmpty(aviso))
{
    <div class="aviso">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.01"/></svg>
        <span>@aviso</span>
    </div>
}

<div class="painel-acoes">
    <div>
        <strong>@Model.Count(t => t.Publicado)</strong> treinos publicados ·
        <strong>@alunosAtivos</strong> alunos ativos
    </div>
    <a asp-area="Personal" asp-controller="Personal" asp-action="CriarTreino" class="btn btn-primary btn-sm">
        + Novo treino
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="vazio-estado">
        <span class="vazio-icone">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 12h10"/><rect x="3" y="8.5" width="3" height="7" rx="1"/><rect x="18" y="8.5" width="3" height="7" rx="1"/><path d="M6.2 6.5v11M17.8 6.5v11" opacity=".55"/></svg>
        </span>
        <strong>Nenhum treino criado ainda</strong>
        <small>Use o botão "Novo treino" para montar a primeira ficha personalizada.</small>
    </div>
}

@foreach (var grupo in Model.GroupBy(t => t.Aluno).OrderBy(g => g.Key.NomeCompleto))
{
    var aluno = grupo.Key;
    var ativo = grupo.FirstOrDefault(t => t.Ativo && t.Publicado);

    <div class="painel-secao" style="margin-top:1.8rem; margin-bottom:0.9rem;">
        <h2>@aluno.NomeCompleto</h2>
        @if (ativo != null)
        {
            <span class="chip chip-verde">@ativo.Nome em uso</span>
        }
        else
        {
            <span class="chip chip-cinza">Sem treino ativo</span>
        }
        <a asp-area="Personal" asp-controller="Personal" asp-action="CriarTreino" asp-route-alunoId="@aluno.Id" class="chip chip-verde" title="Criar treino para este aluno">+ Treino para @aluno.NomeCompleto.Split(' ')[0]</a>
    </div>

    <div class="lista-painel">
        @foreach (var treino in grupo)
        {
            <div class="lista-item @(treino.Ativo && treino.Publicado ? "lista-item-destaque" : "")">
                <div class="lista-info">
                    <strong><a asp-area="Personal" asp-controller="Personal" asp-action="Detalhe" asp-route-id="@treino.Id">@treino.Nome — @treino.Objetivo</a></strong>
                    <small>
                        @treino.Itens.Count exercícios
                        @if (!treino.Publicado)
                        {
                            <span>· oculto do aluno</span>
                        }
                        else if (treino.Ativo)
                        {
                            <span>· em uso pelo aluno</span>
                        }
                        else
                        {
                            <span>· alternativo</span>
                        }
                        <span>· criado em @treino.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    </small>
                </div>
                <div class="lista-acoes lista-acoes-multiplo">
                    @if (treino.Publicado && !treino.Ativo)
                    {
                        <form method="post" asp-area="Personal" asp-controller="Personal" asp-action="Ativar" asp-route-id="@treino.Id"
                              onsubmit="return confirm('Ativar o treino &quot;@treino.Nome&quot; para @aluno.NomeCompleto?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost btn-sm" title="Publicar e marcar como treino em uso">Usar agora</button>
                        </form>
                    }
                    else if (treino.Publicado && treino.Ativo)
                    {
                        <form method="post" asp-area="Personal" asp-controller="Personal" asp-action="AlternarPublicacao" asp-route-id="@treino.Id"
                              onsubmit="return confirm('Ocultar o treino &quot;@treino.Nome&quot; da área do aluno?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost btn-sm" title="Ocultar da área do aluno">Ocultar</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-area="Personal" asp-controller="Personal" asp-action="AlternarPublicacao" asp-route-id="@treino.Id"
                              onsubmit="return confirm('Publicar o treino &quot;@treino.Nome&quot;?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost btn-sm" title="Publicar novamente">Publicar</button>
                        </form>
                    }
                    <a asp-area="Personal" asp-controller="Personal" asp-action="Editar" asp-route-id="@treino.Id" class="btn btn-ghost btn-sm">Editar</a>
                    <form method="post" asp-area="Personal" asp-controller="Personal" asp-action="Excluir" asp-route-id="@treino.Id"
                          onsubmit="return confirm('Excluir o treino &quot;@treino.Nome&quot; de @aluno.NomeCompleto? Esta ação não pode ser desfeita.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-ghost btn-sm btn-perigo" title="Excluir treino">Excluir</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
