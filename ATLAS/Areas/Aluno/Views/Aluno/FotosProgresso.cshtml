@model FotosProgressoViewModel
@{
    var fmt = new System.Globalization.CultureInfo("pt-BR");
}

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="aviso">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        <span>@sucesso</span>
    </div>
}

@if (TempData["Aviso"] is string aviso)
{
    <div class="aviso aviso-erro">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        <span>@aviso</span>
    </div>
}

<div class="saudacao">
    <h2>Fotos de <em>progresso</em></h2>
    <p>Registre sua evolução visual e compare sua transformação ao longo do tempo.</p>
</div>

@if (Model.TemDados)
{
    <div class="painel-secao">
        <h2>Sua galeria</h2>
        <span>@Model.Fotos.Count foto(s)</span>
    </div>
    <div class="galeria-progresso">
        @foreach (var f in Model.Fotos)
        {
            <figure class="galeria-item">
                <img src="@f.Url" alt="@(f.Legenda ?? "Foto de progresso")" loading="lazy" />
                <figcaption>
                    <strong>@(string.IsNullOrWhiteSpace(f.Legenda) ? "Progresso" : f.Legenda)</strong>
                    <small>@f.EnviadaEm.ToLocalTime().ToString("dd/MM/yyyy", fmt)</small>
                    <form method="post" asp-area="Aluno" asp-controller="Aluno" asp-action="ExcluirFoto" asp-route-id="@f.Id"
                          onsubmit="return confirm('Remover esta foto da galeria?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="galeria-remover" title="Remover foto" aria-label="Remover foto">&times;</button>
                    </form>
                </figcaption>
            </figure>
        }
    </div>
}
else
{
    <partial name="_EstadoVazio"
             model='@(new EstadoVazioViewModel { Icone = "users", Titulo = "Galeria de fotos vazia", Descricao = "Envie sua primeira foto de progresso para começar a acompanhar sua transformação ao longo do tempo.", RotuloCta = "Agendar avaliação física", UrlCta = "/agendamento" })' />
}

<div class="painel-secao" style="margin-top:2rem;">
    <h2>Adicionar foto</h2>
    <span>JPG, PNG ou WebP · máx. 5 MB</span>
</div>

<form method="post" asp-area="Aluno" asp-controller="Aluno" asp-action="EnviarFoto"
      enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="card" style="max-width:640px;">
        <div class="form-field">
            <label for="foto">Imagem</label>
            <input type="file" id="foto" name="foto" accept="image/jpeg,image/png,image/webp" required
                   onchange="previewFotoProgresso(this)" />
        </div>

        <div id="previewFoto" style="display:none; margin-bottom:1rem;">
            <img id="previewFotoImg" alt="Pré-visualização" style="max-width:100%; max-height:320px; border-radius:10px; border:1px solid var(--green-line);" />
        </div>

        <div class="form-field">
            <label for="legenda">Legenda (opcional)</label>
            <input type="text" id="legenda" name="legenda" maxlength="80"
                   placeholder="Ex.: Frente — início do plano, Lado — 3 meses" />
        </div>

        <div style="display:flex; justify-content:flex-end; margin-top:0.6rem;">
            <button type="submit" class="btn btn-primary btn-sm">Enviar foto</button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function previewFotoProgresso(input) {
            var box = document.getElementById('previewFoto');
            var img = document.getElementById('previewFotoImg');
            if (input.files && input.files[0]) {
                img.src = URL.createObjectURL(input.files[0]);
                box.style.display = 'block';
            } else {
                box.style.display = 'none';
            }
        }
    </script>
}
