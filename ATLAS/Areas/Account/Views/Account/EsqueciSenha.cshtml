@{
    Layout = "_LayoutAuth";
    var aviso = TempData["Aviso"] as string;
}

<div class="auth-card">
    <h1>Esqueceu sua <span class="txt-verde">senha</span>?</h1>
    <p>Informe o e-mail cadastrado. Se encontrarmos a conta, enviaremos um codigo de 6 digitos para redefinir a senha.</p>

    @if (!string.IsNullOrEmpty(aviso))
    {
        <div class="aviso">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.01"/></svg>
            <span>@aviso</span>
        </div>
    }

    <form asp-action="EsqueciSenha" method="post">
        @Html.AntiForgeryToken()

        <div class="form-field">
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" placeholder="seu@email.com" required autocomplete="email" />
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg">Enviar codigo</button>
    </form>
</div>

<p class="auth-alt">
    Lembrou da senha? <a asp-action="Login">Voltar para o login</a>
</p>
