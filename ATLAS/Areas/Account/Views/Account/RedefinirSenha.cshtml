@{
    Layout = "_LayoutAuth";
    var aviso = TempData["Aviso"] as string;
}

<div class="auth-card">
    <h1>Verifique o <span class="txt-verde">código</span></h1>
    <p>Informe o código de 6 dígitos que enviamos para o seu e-mail. Ele expira em 15 minutos.</p>

    @if (!string.IsNullOrEmpty(aviso))
    {
        <div class="aviso">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="aviso-icone" width="18" height="18" aria-hidden="true">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
            </svg>
            <span>@aviso</span>
        </div>
    }

    <form asp-action="RedefinirSenha" method="post">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="aviso aviso-erro" role="alert"></div>
        }

        <div class="form-field">
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" value="@ViewBag.Email" required readonly autocomplete="email" />
        </div>

        <div class="form-field">
            <label for="codigo">Código de 6 dígitos</label>
            <input type="text" id="codigo" name="codigo" placeholder="000000" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" required autocomplete="one-time-code" />
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg">Verificar código</button>
    </form>
</div>

<p class="auth-alt">
    Não recebeu o código? <a asp-action="EsqueciSenha">Solicitar novamente</a>
</p>