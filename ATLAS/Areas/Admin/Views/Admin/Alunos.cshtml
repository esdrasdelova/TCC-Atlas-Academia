@model List<AlunoListItemViewModel>
@{
    var sucesso = TempData["Sucesso"] as string;
    var erro = TempData["Erro"] as string;
}

<div class="saudacao">
    <h2>Alunos <em>da academia</em></h2>
    <p>Cadastre, edite, ative/desative e acompanhe todos os alunos da plataforma.</p>
</div>

@if (!string.IsNullOrEmpty(sucesso))
{
    <div class="aviso">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        <span>@sucesso</span>
    </div>
}

@if (!string.IsNullOrEmpty(erro))
{
    <div class="aviso aviso-erro">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.01"/></svg>
        <span>@erro</span>
    </div>
}

<div class="painel-acoes">
    <form method="get" class="busca-form" role="search">
        <input type="search" name="q" value="@ViewBag.Busca" placeholder="Buscar por nome ou e-mail…" aria-label="Buscar aluno" />
        <button type="submit" class="btn btn-ghost btn-sm">Buscar</button>
        @if (!string.IsNullOrEmpty(ViewBag.Busca as string))
        {
            <a asp-area="Admin" asp-controller="Admin" asp-action="Alunos" class="btn btn-ghost btn-sm">Limpar</a>
        }
    </form>
    <a asp-area="Admin" asp-controller="Admin" asp-action="AlunoNovo" class="btn btn-primary btn-sm">
        + Cadastrar aluno
    </a>
</div>

<div class="painel-grid painel-grid-3" style="margin-bottom:1.6rem;">
    <div class="card">
        <span class="card-label">Total listado</span>
        <strong class="card-valor"><em>@Model.Count</em></strong>
    </div>
    <div class="card">
        <span class="card-label">Contas ativas</span>
        <strong class="card-valor">@Model.Count(a => a.ContaAtiva)</strong>
    </div>
    <div class="card">
        <span class="card-label">Contas inativas</span>
        <strong class="card-valor">@Model.Count(a => !a.ContaAtiva)</strong>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="vazio-estado">
        <span class="vazio-icone">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19c.6-3 2.8-4.7 5.5-4.7s4.9 1.7 5.5 4.7"/><path d="M15.5 5.4a3.2 3.2 0 0 1 0 5.2"/><path d="M17.3 14.6c1.8.6 3 2 3.4 4.4"/></svg>
        </span>
        <strong>Nenhum aluno encontrado</strong>
        @if (string.IsNullOrEmpty(ViewBag.Busca as string))
        {
            <small>Use o botão "+ Cadastrar aluno" para adicionar o primeiro.</small>
        }
        else
        {
            <small>Tente outra busca ou limpe o filtro.</small>
        }
    </div>
}
else
{
    <div class="lista-painel">
        @foreach (var aluno in Model)
        {
            var iniciais = string.Concat(aluno.NomeCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
            <div class="lista-item">
                <span class="avatar" aria-hidden="true">@iniciais</span>
                <div class="lista-info">
                    <strong>@aluno.NomeCompleto</strong>
                    <small>
                        @aluno.Email
                        @if (!string.IsNullOrEmpty(aluno.Objetivo))
                        {
                            <span>· Objetivo: @aluno.Objetivo</span>
                        }
                        <span>· Cadastro: @aluno.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy")</span>
                        <span>· Treinos: @aluno.QtdTreinos@(aluno.NomeTreinoAtivo == null ? "" : $" (ativo: {aluno.NomeTreinoAtivo})")</span>
                    </small>
                </div>
                <div class="lista-acoes lista-acoes-multiplo">
                    <span class="chip @(aluno.ContaAtiva ? "chip-verde" : "chip-cinza")">@(aluno.ContaAtiva ? "Ativa" : "Inativa")</span>
                    <a asp-area="Admin" asp-controller="Admin" asp-action="AlunoDetalhe" asp-route-id="@aluno.Id" class="btn btn-ghost btn-sm">Detalhes</a>
                    <a asp-area="Admin" asp-controller="Admin" asp-action="AlunoEditar" asp-route-id="@aluno.Id" class="btn btn-ghost btn-sm">Editar</a>
                    <form method="post" asp-area="Admin" asp-controller="Admin" asp-action="AlunoAlternarStatus" asp-route-id="@aluno.Id"
                          onsubmit="return confirm('@(aluno.ContaAtiva ? "Desativar a conta de" : "Reativar a conta de") @aluno.NomeCompleto?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-ghost btn-sm" title="@(aluno.ContaAtiva ? "Desativar conta do aluno" : "Reativar conta do aluno")">
                            @(aluno.ContaAtiva ? "Desativar" : "Ativar")
                        </button>
                    </form>
                    <form method="post" asp-area="Admin" asp-controller="Admin" asp-action="AlunoExcluir" asp-route-id="@aluno.Id"
                          onsubmit="return confirm('Excluir o aluno &quot;@aluno.NomeCompleto&quot;? Os @aluno.QtdTreinos treino(s) dele também serão removidos. Esta ação não pode ser desfeita.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-ghost btn-sm btn-perigo">Excluir</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
