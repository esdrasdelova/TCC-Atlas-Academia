@model TreinoFormViewModel

<div class="saudacao">
    <h2>Editar <em>treino</em></h2>
    <p>Ajuste exercícios, séries e observações da ficha de @ViewBag.NomeAluno.</p>
</div>

<partial name="_FormularioTreino" model="Model" />

<a asp-area="Admin" asp-controller="Admin" asp-action="TreinoDetalhe" asp-route-id="@Model.Id" class="btn btn-ghost btn-sm" style="margin-top:0.9rem;">
    Voltar para a ficha
</a>

@section Scripts {
    <script src="~/js/treino-form.js" asp-append-version="true"></script>
}
