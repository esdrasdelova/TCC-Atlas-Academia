<!-- Assistente Atlas — conversa livre com IA real (respostas do servidor) -->
<button type="button" id="assistente-botao" class="assistente-botao" aria-haspopup="dialog" aria-expanded="false" aria-controls="assistente-painel" title="Assistente IA">
    <span class="assistente-icone" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3.4 13.7 8.6 18.9 10.3 13.7 12 12 17.2 10.3 12 5.1 10.3 10.3 8.6 12 3.4Z" />
            <path d="M18.3 16.3 18.9 17.7 20.3 18.3 18.9 18.9 18.3 20.3 17.7 18.9 16.3 18.3 17.7 17.7 18.3 16.3Z" />
        </svg>
    </span>
    <span class="assistente-rotulo">Assistente IA</span>
</button>

<div id="assistente-painel" class="assistente-painel" role="dialog" aria-modal="false" aria-label="Assistente Atlas" hidden>
    <header class="assistente-topo">
        <span class="assistente-logo">
            <img src="~/images/logo-atlas.png" alt="Atlas" asp-append-version="true" />
        </span>
        <div>
            <strong>Assistente Atlas</strong>
            <small>Pergunte o que quiser sobre treino</small>
        </div>
        <button type="button" id="assistente-fechar" class="assistente-fechar" aria-label="Fechar assistente">&times;</button>
    </header>

    <div class="assistente-corpo" id="assistente-corpo">
        <div id="assistente-mensagens" class="assistente-mensagens" aria-live="polite">
            <div class="msg msg-assistente">
                Olá! Sou o assistente do Atlas. Posso tirar dúvidas sobre treinos, exercícios, hábitos saudáveis e como usar o site. Como posso ajudar?
            </div>
        </div>

        <div id="assistente-sugestoes" class="assistente-sugestoes">
            <button type="button" class="assistente-chip">Quantos dias por semana devo treinar?</button>
            <button type="button" class="assistente-chip">O que devo comer antes do treino?</button>
            <button type="button" class="assistente-chip">Como ver minha ficha de treino aqui no site?</button>
        </div>
    </div>

    <form id="assistente-form" class="assistente-form" autocomplete="off">
        <label for="assistente-input" class="visually-hidden">Digite sua pergunta</label>
        <input type="text" id="assistente-input" class="assistente-input" maxlength="1000" placeholder="Digite sua pergunta..." />
        <button type="submit" id="assistente-enviar" class="assistente-enviar" aria-label="Enviar mensagem">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z"/></svg>
        </button>
    </form>

    <footer class="assistente-rodape">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.01"/></svg>
        Conteúdo educativo — não substitui orientação médica ou profissional.
    </footer>
</div>

<script src="~/js/assistente.js" asp-append-version="true"></script>
