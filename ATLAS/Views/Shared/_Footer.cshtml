@inject ATLAS.Services.ISiteConfigService SiteConfig
<footer class="footer" id="contato">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <a asp-controller="Home" asp-action="Index" class="brand" aria-label="Atlas - Página inicial">
                    <img src="~/images/logo-atlas.png" alt="Atlas" class="brand-logo" asp-append-version="true" />
                </a>
                <p class="footer-about">
                    Centro de treinamento voltado para evolução, saúde e desempenho.
                    Estrutura, tecnologia e profissionais prontos para o seu próximo nível.
                </p>
                <div class="footer-socials" aria-label="Contato rápido">
                    @{
                        var somenteDigitos = new string((SiteConfig.Obter().Telefone ?? string.Empty).Where(char.IsDigit).ToArray());
                    }
                    <a href="https://wa.me/@somenteDigitos" target="_blank" rel="noopener" aria-label="WhatsApp da academia">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z"/><path d="M8.8 9.2c0 3.2 2.8 6 6 6l1.2-1.2-1.8-1.5-1 .6a4.6 4.6 0 0 1-2.3-2.3l.6-1-1.5-1.8z"/></svg>
                    </a>
                    <a href="mailto:@SiteConfig.Obter().Email" aria-label="Enviar e-mail para a academia">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
                    </a>
                </div>
            </div>

            <div class="footer-col">
                <h4>Links rápidos</h4>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Início</a></li>
                    <li><a asp-controller="Sobre" asp-action="Index">Sobre nós</a></li>
                    <li><a asp-controller="Planos" asp-action="Index">Planos</a></li>
                    <li><a asp-controller="Agendamento" asp-action="Index">Agende sua aula</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Modalidades</h4>
                <ul>
                    @foreach (var m in SiteConfig.Obter().Modalidades)
                    {
                        <li><a asp-controller="Modalidades" asp-action="Index">@m.Titulo</a></li>
                    }
                </ul>
            </div>

            <div class="footer-col">
                <h4>Contato</h4>
                <ul class="footer-contact">
                    <li>@SiteConfig.Obter().Endereco</li>
                    <li>@SiteConfig.Obter().Telefone</li>
                    <li>@SiteConfig.Obter().Email</li>
                    <li>@SiteConfig.Obter().HorarioSemana<br />@SiteConfig.Obter().HorarioSabado</li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="footer-bottom-brand">
                <img src="~/images/logosemfundo.png" alt="Atlas" class="footer-logo-brand" asp-append-version="true" />
            </div>
            <p>&copy; @DateTime.Now.Year @SiteConfig.Obter().Nome. Todos os direitos reservados.</p>
            <p class="footer-tagline">@SiteConfig.Obter().Slogan</p>
        </div>
    </div>
</footer>
