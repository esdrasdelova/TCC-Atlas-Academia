# =============================================================================
# ATLAS Centro de Treinamento - Variáveis de Ambiente (Exemplo)
# =============================================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env real no Git!
# =============================================================================

# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------
# URL pública da aplicação (usada para gerar links de recuperação de senha, etc.)
# Em desenvolvimento local: http://localhost:5078
# Em produção: https://seu-dominio.com
APP_URL=http://localhost:5078

# Ambiente: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# -----------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL - Supabase)
# -----------------------------------------------------------------------------
# Connection string completa do Supabase.
# Obtenha em: Settings > Database > Connection string > URI (pooler recomendado)
# Exemplo pooler (porta 6543): postgresql://postgres.xxx:senha@aws-0-region.pooler.supabase.com:6543/postgres
# Exemplo direto (porta 5432): postgresql://postgres:senha@db.xxx.supabase.co:5432/postgres
ConnectionStrings__Atlas=Host=aws-0-sa-east-1.pooler.supabase.com;Database=postgres;Username=postgres.SEU_PROJECT_REF;Password=SUA_SENHA;SSL Mode=Require;Trust Server Certificate=true

# -----------------------------------------------------------------------------
# ASSISTENTE DE IA (Chat Completions API compatível)
# -----------------------------------------------------------------------------
# Provedor: groq (padrão, gratuito generoso) | openai | openrouter | custom
IA__Provider=groq

# Chave da API do provedor escolhido:
# - Groq: gsk_... (gratuito, sem cartão) - https://console.groq.com/keys
# - OpenAI: sk-... (créditos gratuitos iniciais) - https://platform.openai.com/api-keys
# - OpenRouter: sk-or-... (modelos gratuitos) - https://openrouter.ai/keys
IA__ApiKey=

# Modelo (opcional - usa padrão do provedor se vazio):
# - Groq: llama-3.1-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
# - OpenAI: gpt-4o-mini | gpt-4o | gpt-3.5-turbo
# - OpenRouter: meta-llama/llama-3.1-70b-instruct:free | google/gemma-2-9b-it:free
IA__Modelo=

# URL base da API (opcional - usa padrão do provedor se vazio)
# - Groq: https://api.groq.com/openai/v1
# - OpenAI: https://api.openai.com/v1
# - OpenRouter: https://openrouter.ai/api/v1
IA__BaseUrl=

# Parâmetros de geração (opcionais)
IA__MaxTokens=600
IA__Temperatura=0.5
IA__TempoLimiteSegundos=30

# -----------------------------------------------------------------------------
# ENVIO DE E-MAIL (Recuperação de senha, contato)
# -----------------------------------------------------------------------------
# Provedor: resend (padrão, 3.000 emails/mês grátis) | brevo (300 emails/dia grátis) | smtp
EMAIL__Provider=resend

# E-mail remetente (From) - deve ser verificado no provedor
EMAIL__Remetente=noreply@seudominio.com

# Nome de exibição do remetente
EMAIL__NomeExibicao=Atlas Centro de Treinamento

# E-mail de destino para formulários de contato (opcional)
EMAIL__Destino=contato@seudominio.com

# Chave da API do provedor escolhido:
# - Resend: re_... (gratuito 3.000/mês) - https://resend.com/api-keys
# - Brevo: xsmtpkey-... (gratuito 300/dia) - https://app.brevo.com/settings/keys
EMAIL__ApiKey=

# Configurações SMTP (apenas se EMAIL__Provider=smtp)
EMAIL__Smtp__Host=smtp-relay.brevo.com
EMAIL__Smtp__Porta=587
EMAIL__Smtp__UsarSsl=true
EMAIL__Smtp__Usuario=
EMAIL__Smtp__Senha=

# -----------------------------------------------------------------------------
# SEGURANÇA / LOGIN
# -----------------------------------------------------------------------------
# Proteção contra força bruta no login
LoginProtection__LimiteTentativas=5
LoginProtection__Janela=00:10:00
LoginProtection__Bloqueio=00:15:00

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DO SITE (Editáveis pelo painel ADM futuramente)
# -----------------------------------------------------------------------------
SiteConfig__Nome=Atlas Centro de Treinamento
SiteConfig__Slogan=Supere. Treine. Evolua.
SiteConfig__Telefone=(11) 99999-0000
SiteConfig__Email=contato@atlasct.com.br
SiteConfig__Endereco=Av. Dr. José Erineu Ortigosa, 187 - Distrito Industrial I, Barra Bonita - SP, 17340-000
SiteConfig__MapaEmbedUrl=https://www.google.com/maps?q=Av.+Dr.+Jos%C3%A9+Erineu+Ortigosa,+187+-+Distrito+Industrial+I,+Barra+Bonita+-+SP,+17340-000&z=16&output=embed
SiteConfig__MapaLinkUrl=https://www.google.com/maps/place/Av.+Dr.+Jos%C3%A9+Erineu+Ortigosa,+187+-+Distrito+Industrial+I,+Barra+Bonita+-+SP,+17340-000/@-22.4868227,-48.5656394,17z/
SiteConfig__HorarioSemana=Seg a Sex — 5:40 às 11:00 · 13:00 às 21:00
SiteConfig__HorarioSabado=Sábado — 8:00 às 11:00

# -----------------------------------------------------------------------------
# PROXY (apenas para produção atrás de load balancer/nginx/IIS)
# -----------------------------------------------------------------------------
# ConfiarProxy=true  # Somente se a app estiver atrás de proxy de confiança (não localhost)